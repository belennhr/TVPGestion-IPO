<Window x:Class="TVPGestion_IPO.Views.navBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVPGestion_IPO.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Menu" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*" MinWidth="150"/>
            <ColumnDefinition Width="0.8*"/>
        </Grid.ColumnDefinitions>

        <!-- Frame principal -->
        <Frame Grid.Column="1" x:Name="navframe" NavigationUIVisibility="Hidden" Background="#e9ecef" Grid.RowSpan="2"/>
        <!-- Agrega margen para que la sombra sea visible -->
        <Grid x:Name="navBar1" Background ="#FFE0F1FE" Grid.Column="0" Grid.RowSpan="2">
            <Grid.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.5"/>
            </Grid.Effect>

            <Grid.RowDefinitions>
                <RowDefinition Height="120.84"/>
                <RowDefinition Height="17.16"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- User Info -->
            <StackPanel x:Name="panelUserInfo" Grid.Row="0" Background="Transparent" Grid.RowSpan="2">
                <materialDesign:PackIcon Kind="AccountCircleOutline" 
                         Width="70" Height="70" 
                         Margin="0,10,0,10"
                         HorizontalAlignment="Center"/>
                <Label x:Name="lblNombreUsuario" Content="Nombre Usuario" 
                       FontSize="14" FontWeight="Bold"
                       Width="120" Height="26" 
                       HorizontalAlignment="Center"/>
                <Label x:Name="separator" 
                       Content="_______________________________________________"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       FontSize="12" Height="22" RenderTransformOrigin="0.511,0.202"/>
            </StackPanel>

            <!-- Sidebar -->
            <ListBox SelectionMode="Single" 
                     SelectionChanged="sidebar_SelectionChanged" 
                     x:Name="sidebar" Grid.Row="2" Margin="0,0,0,5" 
                     BorderThickness="0"
                     Background="#FFE0F1FE">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <DockPanel LastChildFill="False"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="5,0,0,0"/>
                        <Setter Property="DockPanel.Dock" Value="Top"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#065386"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem x:Name="lbiProductos">
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <materialDesign:PackIcon Kind="Food" 
                             Width="25" Height="25" 
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>
                        <TextBlock Text="Productos" 
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="lbiPedidos">
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <materialDesign:PackIcon Kind="Cart" 
                             Width="25" Height="25" 
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>
                        <TextBlock Text="Pedidos" 
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="lbiClientes">
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <materialDesign:PackIcon Kind="AccountMultiple" 
                             Width="25" Height="25" 
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>
                        <TextBlock Text="Clientes" 
                                    FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <!--Opciones alineadas abajo-->
                <ListBoxItem x:Name="lbiLogout" DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <materialDesign:PackIcon Kind="Logout" 
                             Width="25" Height="25" 
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>
                        <TextBlock Text="Log out" 
                            FontSize="14"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="lbiEditPerfil" DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <materialDesign:PackIcon Kind="AccountCogOutline" 
                             Width="25" Height="25" 
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>
                        <TextBlock Text="Editar Perfil" 
                            FontSize="14"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

        </Grid>

        <!-- Frame principal -->
    </Grid>
</Window>
