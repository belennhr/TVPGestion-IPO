<Window x:Class="TVPGestion_IPO.Views.navBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVPGestion_IPO.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Menu" WindowState="Maximized" MinHeight="450" MinWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Frame principal -->
        <Frame Grid.Column="1" x:Name="navframe" 
               NavigationUIVisibility="Hidden" 
               Background="#e9ecef"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch"/>

        <!-- Barra de navegación lateral -->
        <Grid x:Name="navBar1" Background="#FFE0F1FE" Grid.Column="0">
            <Grid.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.5"/>
            </Grid.Effect>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- User Info -->
                <StackPanel x:Name="panelUserInfo" Grid.Row="0" Background="Transparent">
                    <Viewbox MaxHeight="80" MaxWidth="80" Margin="0,10">
                        <materialDesign:PackIcon Kind="AccountCircleOutline" 
                                                 Width="70" Height="70"
                                                 HorizontalAlignment="Center"/>
                    </Viewbox>
                    <TextBlock x:Name="lblNombreUsuario" Text="Nombre Usuario" 
                               FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="5,0,5,10"/>
                    <Separator Margin="0,0,0,10" Background="Gray"/>
                </StackPanel>

                <!-- Sidebar -->
                <ListBox SelectionMode="Single" 
                         SelectionChanged="sidebar_SelectionChanged" 
                         x:Name="sidebar" Grid.Row="1" 
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="{TemplateBinding Margin}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#065386"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#0873B8"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem x:Name="lbiProductos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Food" 
                                                     Grid.Column="0"
                                                     Width="25" Height="25" 
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Productos" 
                                       Grid.Column="1"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem x:Name="lbiPedidos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Cart" 
                                                     Grid.Column="0"
                                                     Width="25" Height="25" 
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Pedidos" 
                                       Grid.Column="1"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem x:Name="lbiClientes">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AccountMultiple" 
                                                     Grid.Column="0"
                                                     Width="25" Height="25" 
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Clientes" 
                                       Grid.Column="1"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <!-- Opciones inferiores -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <ListBox SelectionMode="Single" 
                             SelectionChanged="sidebar_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#065386"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0873B8"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem x:Name="lbiEditPerfil">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountCogOutline" 
                                                         Grid.Column="0"
                                                         Width="25" Height="25" 
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Editar Perfil" 
                                           Grid.Column="1"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem x:Name="lbiLogout">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Logout" 
                                                         Grid.Column="0"
                                                         Width="25" Height="25" 
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Log out" 
                                           Grid.Column="1"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
