<Window x:Class="TVPGestion_IPO.Views.navBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVPGestion_IPO.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Menu" WindowState="Maximized" MinHeight="450" MinWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*" MinWidth="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Frame principal -->
        <Grid Grid.Column="1">

            <Frame x:Name="navframe" 
                   NavigationUIVisibility="Hidden" 
                   Background="#e9ecef"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   Navigated="navframe_Navigated"/>

            <StackPanel HorizontalAlignment="Right" 
                        VerticalAlignment="Bottom" 
                        Margin="0,0,30,30" 
                        Panel.ZIndex="99">

                <Border x:Name="HelpBubble" 
                        Background="White" 
                        BorderBrush="#065386" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="15" 
                        Margin="0,0,0,10"
                        Visibility="Collapsed" 
                        MaxWidth="250">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.3"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Ayuda Rápida" FontWeight="Bold" Foreground="#065386" Margin="0,0,0,5"/>

                        <TextBlock x:Name="txtHelpContent" 
                                   Text="Cargando ayuda..." 
                                   TextWrapping="Wrap" 
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <Button x:Name="btnFloatingHelp"
                        Click="btnFloatingHelp_Click"
                        Width="50" Height="50"
                        HorizontalAlignment="Right"
                        Background="#065386"
                        BorderBrush="White"
                        BorderThickness="2"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        ToolTip="Ver ayuda de esta pantalla">
                    <materialDesign:PackIcon Kind="Help" Width="28" Height="28" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>


        <!-- Barra de navegación lateral -->
        <Grid x:Name="navBar1" Background="#FFE0F1FE" Grid.Column="0">
            <Grid.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.5"/>
            </Grid.Effect>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- User Info -->
                <StackPanel x:Name="panelUserInfo" Grid.Row="0" Background="Transparent">
                    <Viewbox MaxHeight="80" MaxWidth="80" Margin="0,10">
                        <materialDesign:PackIcon Kind="AccountCircleOutline" 
                                                 Width="70" Height="70"
                                                 HorizontalAlignment="Center"/>
                    </Viewbox>
            
                    <!-- Envolver el nombre de usuario en Viewbox -->
                    <Viewbox MaxHeight="25" Margin="5,0,5,10" 
                             Stretch="Uniform" 
                             StretchDirection="DownOnly">
                        <TextBlock x:Name="lblNombreUsuario" 
                                   Text="Nombre Usuario" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextAlignment="Center"
                                   Padding="5,0"/>
                    </Viewbox>
            
                    <Separator Margin="0,0,0,10" Background="Gray"/>
                </StackPanel>

                <!-- Sidebar -->
                <ListBox SelectionMode="Single" 
                         SelectionChanged="sidebar_SelectionChanged" 
                         x:Name="sidebar" Grid.Row="1" 
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="{TemplateBinding Margin}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#065386"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#0873B8"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem x:Name="lbiProductos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Icono con Viewbox -->
                            <Viewbox Grid.Column="0" 
                                     MaxHeight="30" MaxWidth="30"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Food" 
                                                         Width="25" Height="25"/>
                            </Viewbox>
                            
                            <!-- Texto con Viewbox -->
                            <Viewbox Grid.Column="1" 
                                     MaxHeight="20"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <TextBlock Text="Productos" 
                                           FontSize="16"
                                           TextWrapping="NoWrap"
                                           Padding="2"/>
                            </Viewbox>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem x:Name="lbiPedidos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Grid.Column="0" 
                                     MaxHeight="30" MaxWidth="30"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Cart" 
                                                         Width="25" Height="25"/>
                            </Viewbox>
                            
                            <Viewbox Grid.Column="1" 
                                     MaxHeight="20"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <TextBlock Text="Pedidos" 
                                           FontSize="16"
                                           TextWrapping="NoWrap"
                                           Padding="2"/>
                            </Viewbox>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem x:Name="lbiClientes">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Grid.Column="0" 
                                     MaxHeight="30" MaxWidth="30"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountMultiple" 
                                                         Width="25" Height="25"/>
                            </Viewbox>
                            
                            <Viewbox Grid.Column="1" 
                                     MaxHeight="20"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <TextBlock Text="Clientes" 
                                           FontSize="16"
                                           TextWrapping="NoWrap"
                                           Padding="2"/>
                            </Viewbox>
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <!-- Botones inferiores -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="btnEditPerfil" 
                            Click="btnEditPerfil_Click"
                            Padding="10,8"
                            Margin="0,2"
                            HorizontalContentAlignment="Stretch"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="Black"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0873B8"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#065386"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Grid.Column="0" 
                                     MaxHeight="30" MaxWidth="30"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountCogOutline" 
                                                         Width="25" Height="25"/>
                            </Viewbox>
                            
                            <Viewbox Grid.Column="1" 
                                     MaxHeight="20"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <TextBlock Text="Editar Perfil" 
                                           FontSize="16"
                                           TextWrapping="NoWrap"
                                           Padding="2"/>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <Button x:Name="btnInfo" 
                            Click="btnInfo_Click"
                            Padding="10,8"
                            Margin="0,2"
                            HorizontalContentAlignment="Stretch"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="Black"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0873B8"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#065386"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Grid.Column="0" 
                                     MaxHeight="30" MaxWidth="30"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="info" 
                                                         Width="25" Height="25"/>
                            </Viewbox>
                            
                            <Viewbox Grid.Column="1" 
                                     MaxHeight="20"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <TextBlock FontSize="16"
                                           TextWrapping="NoWrap"
                                           Padding="2"><Run Language="es-es" Text="Información"/></TextBlock>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <Button x:Name="btnLogout_Copiar" 
                            Click="btnLogout_Click"
                            Padding="10,8"
                            HorizontalContentAlignment="Stretch"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="Black"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0873B8"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#065386"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Grid.Column="0" 
                                     MaxHeight="30" MaxWidth="30"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Logout" 
                                                         Width="25" Height="25"/>
                            </Viewbox>
                            
                            <Viewbox Grid.Column="1" 
                                     MaxHeight="20"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <TextBlock Text="Log out" 
                                           FontSize="16"
                                           TextWrapping="NoWrap"
                                           Padding="2"/>
                            </Viewbox>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
