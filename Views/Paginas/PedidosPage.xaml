<Page x:Class="TVPGestion_IPO.Views.PedidosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TVPGestion_IPO.Views"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PedidosPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="54"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Titulo -->
        <Viewbox Grid.Row="0" 
                 Stretch="Uniform" 
                 HorizontalAlignment="Left"
                 MaxHeight="60"
                 Margin="40,10,0,10" Width="339">
            <Label Content="Gestion de Pedidos" 
                   FontSize="25" 
                   FontWeight="Bold"/>
        </Viewbox>

        <Grid Grid.Row="1" Margin="28,0,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="120"/>
            </Grid.ColumnDefinitions>

            <!-- Barra de busqueda -->
            <Viewbox Grid.Column="0" 
                     Stretch="Uniform" 
                     StretchDirection="Both"
                     MaxHeight="40"
                     HorizontalAlignment="Stretch">
                <Grid Width="300" Height="32">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="White" Margin="10,0,0,0">
                        <TextBox x:Name="SearchBox"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,5,0"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 TextChanged="SearchBox_TextChanged" Margin="30,0,9,-2"/>
                    </Border>
                    <materialDesign:PackIcon Kind="Search" Width="24" Height="24" 
                                             Foreground="Gray"
                                             Margin="15,0,0,0"
                                             VerticalAlignment="Center"/>
                </Grid>
            </Viewbox>
        </Grid>
        
        <!-- DataGrid de pedidos -->
        <DataGrid Grid.Row="2"
                  x:Name="PedidosDataGrid"
                  Margin="40,28,28,40"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F5F5"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  Background="#FFE0F1FE"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="MinHeight" Value="35"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#065386"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="MinHeight" Value="40"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <!--Editar Pedidos-->
                <DataGridTemplateColumn x:Name="Editar" Header="" Width="50" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="2"
                                    Click="BtnEditPedido_Click"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ToolTip="Editar pedido seleccionado">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="24" Height="24" Stretch="Uniform">
                                    <materialDesign:PackIcon Kind="Pencil"
                                                             Foreground="#065386"
                                                             Width="21" Height="22"/>
                                </Viewbox>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--Borrar Pedidos-->
                <DataGridTemplateColumn Header="" Width="50" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="2"
                                    Click="BtnDeletePedido_Click"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ToolTip="Eliminar pedido">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="24" Height="24" Stretch="Uniform">
                                    <materialDesign:PackIcon Kind="Delete"
                                                             Foreground="#065386"
                                                             Width="24" Height="23"/>
                                </Viewbox>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Campos especificos con TextWrapping para mejor responsive -->
                
                <!-- ID del Pedido -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.5*" MinWidth="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Fecha y Hora de Realizacion -->
                <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding FechaHoraRealizacion}" Width="1*" MinWidth="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Medio: En Local / Telefono -->
                <DataGridTextColumn Header="Medio" Binding="{Binding Medio}" Width="0.7*" MinWidth="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Modalidad: RecogerAhora / RecogerHora / Domicilio -->
                <DataGridTextColumn Header="Modalidad" Binding="{Binding Modalidad}" Width="0.9*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Hora de Recogida/Recepcion -->
                <DataGridTextColumn Header="Hora Recogida" Binding="{Binding FechaHoraRecogida}" Width="1*" MinWidth="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Email del Cliente -->
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteEmail}" Width="1.2*" MinWidth="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Direccion de Entrega (solo para Domicilio) -->
                <DataGridTextColumn Header="Direccion" Binding="{Binding DireccionEntrega}" Width="1.3*" MinWidth="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Productos del Pedido -->
                <DataGridTextColumn Header="Productos" Binding="{Binding ProductosString}" Width="1.5*" MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Importe Total -->
                <DataGridTextColumn Header="Importe" Binding="{Binding ImporteTotal, StringFormat={}{0:C}}" Width="0.7*" MinWidth="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Forma de Pago -->
                <DataGridTextColumn Header="Pago" Binding="{Binding FormaPago}" Width="0.7*" MinWidth="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Estado del Pedido -->
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="0.9*" MinWidth="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Coste de Envio (solo para Domicilio) -->
                <DataGridTextColumn Header="Envio" Binding="{Binding CosteEnvio, StringFormat={}{0:C}}" Width="0.6*" MinWidth="65">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Puntos Ganados -->
                <DataGridTextColumn Header="Puntos" Binding="{Binding PuntosGanados}" Width="0.6*" MinWidth="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
