<Page x:Class="TVPGestion_IPO.Views.ClientesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TVPGestion_IPO.Views"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="ClientesPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Left" MaxHeight="60" Margin="40,10,28,10">
            <Label Content="Gestión de Clientes" FontSize="25" FontWeight="Bold"/>
        </Viewbox>

        <Grid Grid.Row="1" Margin="28,0,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="120"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="Both" MaxHeight="40" HorizontalAlignment="Stretch">
                <Grid Width="300" Height="32">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="White" Margin="10,0,0,0">
                        <TextBox x:Name="SearchBox" Height="32" VerticalContentAlignment="Center" Padding="0,0,5,0"
                                 FontSize="14" BorderThickness="0" Background="Transparent"
                                 TextChanged="SearchBox_TextChanged" Margin="30,0,9,-2"/>
                    </Border>
                    <materialDesign:PackIcon Kind="Search" Width="24" Height="24" Foreground="Gray" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Viewbox>

            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both" MaxHeight="40" HorizontalAlignment="Stretch">
                <Button x:Name="BtnAddCliente" Width="137" Height="32" Click="BtnAddCliente_Click"
                        Style="{StaticResource RoundedButton}" Background="#e9ecef" BorderBrush="#ccc" ToolTip="Crear un nuevo cliente">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Add" Width="24" Height="24" Foreground="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Añadir cliente" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Viewbox>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="ClientesDataGrid"
                  Margin="40,10,28,10"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F5F5" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeColumns="False" CanUserSortColumns="True"
                  IsReadOnly="True" Background="#FFE0F1FE"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="MinHeight" Value="35"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#065386"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="MinHeight" Value="40"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="Editar" Header="" Width="50" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="2" Click="BtnEditCliente_Click" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Editar cliente seleccionado">
                                <Viewbox Width="24" Height="24" Stretch="Uniform">
                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#065386" Width="21" Height="22"/>
                                </Viewbox>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="50" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="2" Click="BtnDeleteCliente_Click" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Eliminar cliente">
                                <Viewbox Width="24" Height="24" Stretch="Uniform">
                                    <materialDesign:PackIcon Kind="Delete" Foreground="#065386" Width="24" Height="23"/>
                                </Viewbox>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" MinWidth="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Direcciones" Binding="{Binding DireccionesString}" Width="1.5*" MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Teléfonos" Binding="{Binding TelefonosString}" Width="*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Emails" Binding="{Binding EmailsString}" Width="*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Alergias" Binding="{Binding AlergiasString}" Width="*" MinWidth="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Pago" Binding="{Binding FormaPago}" Width="*" MinWidth="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Puntos" Binding="{Binding PuntosAcumulados}" Width="Auto" MinWidth="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Margin="40,0,28,20" 
                DataContext="{Binding ElementName=ClientesDataGrid, Path=SelectedItem}"
                BorderBrush="#065386" BorderThickness="1" CornerRadius="5" Background="White">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#E3F2FD" CornerRadius="5,5,0,0" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#065386"/>
                        <TextBlock Text="Historial de Pedidos" FontWeight="Bold" Foreground="#065386" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding HistorialPedidos}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          BorderThickness="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding ImporteTotal, StringFormat={}{0:C}€}" Width="*"/>
                        <DataGridTextColumn Header="Pago" Binding="{Binding FormaPago}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" 
                           Text="Selecciona un cliente para ver sus pedidos"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           FontSize="14"
                           FontStyle="Italic"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ClientesDataGrid, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</Page>