<Window x:Class="TVPGestion_IPO.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVPGestion_IPO.Views"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid x:Name="Grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="54*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="LoginBackGround" Grid.Column="1" Grid.RowSpan="11" Fill="#FFE0F1FE" RadiusX="10" RadiusY="10" Margin="0,48,0,48">
            <Rectangle.Effect>
                <DropShadowEffect Color="Black" 
                          BlurRadius="15" 
                          ShadowDepth="5" 
                          Opacity="0.3" 
                          Direction="315"/>
            </Rectangle.Effect>
        </Rectangle>
        <Viewbox Grid.Row="1" Grid.Column="1">
            <Label Content="Inicio de Sesión" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="48" Width="270" FontSize="22" FontWeight="Bold"/>

        </Viewbox>
        <Viewbox Grid.Row="9" Grid.Column="1" Stretch="Uniform">
            <Button x:Name="LoginBtn" Content="Iniciar Sesión" 
                    Grid.Row="9" Grid.Column="1" Margin="60,0,60,20" 
                    FontSize="14" BorderThickness="1,3,1,3" TabIndex="3" 
                    Padding="5" BorderBrush="#065386"
                    FontWeight="Bold" Background="#065386"
                    Foreground="White"
                    Style="{StaticResource RoundedButton}"
                    Click="Button_Click" Height="35" Width="103"/>
        </Viewbox>
        <TextBox x:Name="credentialInput"
                 Grid.Row="4" Grid.Column="1"
                 Style="{StaticResource RoundedTextBox}"
                 VerticalContentAlignment="Center"
                 FontSize="14" 
                 Margin="20,0,30,10" 
                 TabIndex="1"/>
        <PasswordBox x:Name="passwordInput"
                     Grid.Row="7" Grid.Column="1"
                     Style="{StaticResource RoundedPasswordBox}"
                     PasswordChar="*"
                     VerticalContentAlignment="Center"
                     FontSize="16" 
                     Margin="20,0,30,10" 
                     TabIndex="2"/>
        <Viewbox Grid.Row="3" Grid.Column="1">
            <Label Content="Usuario:" VerticalContentAlignment="Center" Height="48" Width="270" FontSize="22" FontWeight="Bold" Margin="0,0,200,0"/>
        </Viewbox>
        <Viewbox Grid.Row="6" Grid.Column="1">
            <Label Content="Contraseña:" VerticalContentAlignment="Center" Height="48" Width="270" FontSize="22" FontWeight="Bold" Margin="0,0,200,0"/>
        </Viewbox>
        <Viewbox Grid.Row="8" Grid.Column="1">
            <Label x:Name="errorMsg" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="48" Width="270" FontSize="11" FontWeight="Bold" Content="" Background="#00000000" Foreground="#FFDC3545"/>

        </Viewbox>
    </Grid>
</Window>
